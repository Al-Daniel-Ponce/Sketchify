# Copy to .env for local testing. Never commit real values.
PORT=8080

# Long random token baked into the app as ANIME_APP_TOKEN.
# Generate with: openssl rand -hex 32
APP_TOKEN=

# Provider key. This stays on the server and must never ship in the APK.
REPLICATE_API_TOKEN=

# The 64-character version hash for the hosted anime model.
# Get it from: https://api.replicate.com/v1/models/<owner>/<name>
REPLICATE_MODEL_VERSION=

# Optional extra model inputs, as JSON.
# Example: {"model_name":"face_paint_512_v2"}
REPLICATE_INPUT_JSON={}

# Stop polling before the app's 60-second timeout.
ANIME_TIMEOUT_MS=55000

# Per-IP requests per hour.
RATE_LIMIT_MAX=30

# --- Optional online face transform ----------------------------------------
# Leave FACE_MODEL and FACE_MODEL_VERSION empty to disable /face-transform
# while keeping /anime available. Set either a model (owner/name) or a 64-
# character version hash. Per-direction values override the shared settings,
# which is useful when feminize and masculinize use different models.
FACE_MODEL=
FACE_MODEL_VERSION=
FACE_FEMINIZE_MODEL=
FACE_FEMINIZE_MODEL_VERSION=
FACE_MASCULINIZE_MODEL=
FACE_MASCULINIZE_MODEL_VERSION=

# How the app's upload is passed to the model. Most models take a data URI
# under "image".
FACE_IMAGE_FIELD=image

# Optional direction input. Leave FACE_DIRECTION_FIELD empty when the model
# has no target-gender input (use per-direction models instead).
FACE_DIRECTION_FIELD=
FACE_DIRECTION_VALUE_FEMINIZE=female
FACE_DIRECTION_VALUE_MASCULINIZE=male

# Extra model inputs. All JSON objects are merged; the per-direction object
# wins over FACE_INPUT_JSON.
FACE_INPUT_JSON={}
FACE_FEMINIZE_INPUT_JSON={}
FACE_MASCULINIZE_INPUT_JSON={}

# Stop polling before the app's 120-second face transform timeout.
FACE_TIMEOUT_MS=110000

# Face transform is slower and more expensive than anime, so it has its own
# per-IP hourly budget.
FACE_RATE_LIMIT_MAX=10
